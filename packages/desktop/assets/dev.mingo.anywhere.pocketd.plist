<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.mingo.anywhere.pocketd</string>
  <key>BundleProgram</key><string>Contents/Library/Helpers/AnywhereDaemon.app/Contents/MacOS/pocketd</string>
  <key>ProgramArguments</key>
  <array>
    <string>pocketd</string>
    <string>serve</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>dev.mingo.anywhere</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
