{
  "expo": {
    "name": "Anywhere",
    "slug": "anywhere",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "anywhere",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mingo.anywhere"
    },
    "android": {
      "package": "dev.mingo.anywhere",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
