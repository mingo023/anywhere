---
import Head from "../components/Head.astro";

type Props = { title: string; description: string; path: string };
const { path } = Astro.props;
const current = (href: string) => (href === path ? "page" : undefined);
---
<!doctype html>
<html lang="en">
<head>
	<Head {...Astro.props} fonts="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap">
		<link rel="stylesheet" href="/style.css">
	</Head>
</head>
<body class="doc">
	<div class="backdrop" aria-hidden="true"></div>

	<header class="nav glass-light">
		<a class="brand" href="/"><img src="/assets/icon.png" alt="" width="26" height="26">Zoes</a>
		<nav>
			<a href="/#tour">Features</a>
			<a href="/blog/">Blog</a>
			<a href="https://github.com/mingo023/anywhere">GitHub</a>
			<a href="https://github.com/mingo023/anywhere/releases">Releases</a>
		</nav>
		<a class="btn primary small" href="https://github.com/mingo023/anywhere/releases/latest/download/Anywhere.dmg">Download</a>
	</header>

	<main class="doc-main">
		<slot />
	</main>

	<footer class="footer">
		<span>Zoes</span>
		<nav>
			<a href="/blog/">Blog</a>
			<a href="https://github.com/mingo023/anywhere">GitHub</a>
			<a href="https://github.com/mingo023/anywhere/releases">Releases</a>
			<a href="/privacy" aria-current={current("/privacy")}>Privacy</a>
			<a href="/support" aria-current={current("/support")}>Support</a>
		</nav>
	</footer>
</body>
</html>
