---
import Head from "../components/Head.astro";

type Props = { title: string; description: string; path: string };
---
<!doctype html>
<html lang="en">
<head>
	<Head {...Astro.props} themeColor="#0a0a0b">
		<link rel="stylesheet" href="/docs/docs.css">
		<script is:inline src="/docs/docs.js" defer></script>
		<slot name="head" />
	</Head>
</head>
<body>
	<a class="skip" href="#main">Skip to content</a>
	<header class="topbar">
		<button class="menu-button" type="button" aria-controls="docs-nav" aria-expanded="false" aria-label="Open navigation">
			<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
		</button>
		<a class="brand" href="/" aria-label="Anywhere home"><img src="/assets/icon.png" alt="" width="24" height="24"><span>Anywhere</span></a>
		<nav class="top-links" aria-label="Site">
			<a href="/">Home</a>
			<a href="/docs/">Docs</a>
			<a href="/blog/">Blog</a>
			<a href="https://github.com/mingo023/anywhere">GitHub</a>
		</nav>
		<a class="download" href="https://github.com/mingo023/anywhere/releases/latest/download/Anywhere.dmg">Download</a>
	</header>
	<div class="layout">
		<nav class="sidebar" id="docs-nav" aria-label="Documentation">
			<p class="nav-group">Get started</p>
			<ul>
				<li><a href="/docs/">Run your first agent</a></li>
				<li><a href="/docs/install">Install Anywhere</a></li>
			</ul>
			<p class="nav-group">Use Anywhere</p>
			<ul>
				<li><a href="/docs/sessions">Sessions and status</a></li>
				<li><a href="/docs/worktrees">Work in worktrees</a></li>
				<li><a href="/docs/review">Review and commit changes</a></li>
				<li><a href="/docs/board">Plan work on the Board</a></li>
				<li><a href="/docs/automations">Schedule automations</a></li>
				<li><a href="/docs/delegation">Delegate work from a chat</a></li>
				<li><a href="/docs/hosts">Run agents on another machine</a></li>
				<li><a href="/docs/iphone">Pair an iPhone</a></li>
			</ul>
			<p class="nav-group">Reference</p>
			<ul>
				<li><a href="/docs/agents">Supported agents</a></li>
				<li><a href="/docs/cli">The anywhere command</a></li>
			</ul>
			<p class="nav-group">Explanation</p>
			<ul>
				<li><a href="/docs/architecture">How Anywhere runs</a></li>
			</ul>
		</nav>
		<main id="main">
			<slot />
		</main>
		<aside class="toc" aria-label="On this page"><p class="toc-title">On this page</p></aside>
	</div>
</body>
</html>
