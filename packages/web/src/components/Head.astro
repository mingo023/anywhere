---
type Props = {
	title: string;
	description: string;
	path: string;
	article?: { author: string; published: string; modified: string };
	rss?: boolean;
	themeColor?: string;
	fonts?: string;
};

const {
	title,
	description,
	path,
	article,
	rss,
	themeColor,
	fonts = "https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap",
} = Astro.props;
const url = new URL(path, Astro.site).href;
const image = new URL("/assets/og.png", Astro.site).href;
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{article && <meta name="author" content={article.author}>}
<link rel="canonical" href={url}>
{rss && <link rel="alternate" type="application/rss+xml" title="Zoes blog" href={new URL("/blog/rss.xml", Astro.site).href}>}
<meta property="og:type" content={article ? "article" : "website"}>
<meta property="og:site_name" content="Zoes, coding agent workspace">
<meta property="og:locale" content="en_US">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Zoes on macOS, with agent sessions grouped by project and worktree">
{article && <meta property="article:published_time" content={article.published}>}
{article && <meta property="article:modified_time" content={article.modified}>}
{article && <meta property="article:author" content={article.author}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
{themeColor && <meta name="theme-color" content={themeColor}>}
<link rel="icon" href="/assets/icon.png" type="image/png" sizes="256x256">
<link rel="icon" href="/favicon.ico" sizes="any">
<slot name="icons" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={fonts} rel="stylesheet">
<slot />
