{
  "target": {
    "kind": "headless",
    "launch": "POCKET_HOME=~/.coding-pocket-dev packages/desktop/target/release/pocket-desktop",
    "capture": ".ui-review/fixture/capture.sh",
    "url": null,
    "window_owner": "pocket-desktop"
  },
  "viewport": [1440, 900],
  "blast_radius": ["packages/desktop/crates/theme/**", "packages/desktop/crates/ui/**", "packages/desktop/crates/pocket/src/view.rs", "packages/desktop/crates/pocket/src/overlay.rs", "packages/desktop/crates/pocket/src/forms.rs"],
  "screens": {
    "sessions": {
      "files": ["packages/desktop/crates/pocket/src/view.rs", "packages/desktop/crates/workspace/**", "packages/desktop/crates/pocket/src/termview.rs"],
      "open": ["launch the app", "click a session card in the left sessions list"],
      "capture": ["session"]
    },
    "changes": {
      "files": ["packages/desktop/crates/pocket/src/diff.rs", "packages/desktop/crates/git/**"],
      "open": ["select a session", "click the Changes tab", "click a diff line to open the comment composer"],
      "capture": ["changes", "comment"]
    },
    "split": {
      "files": ["packages/desktop/crates/pocket/src/view.rs", "packages/desktop/crates/workspace/**", "packages/desktop/crates/pocket/src/termview.rs"],
      "open": ["select a session", "click the split-pane button to add panes to the active tab"]
    },
    "inbox": {
      "files": ["packages/desktop/crates/pocket/src/inbox.rs"],
      "open": ["click the bell in the sidebar"],
      "capture": ["inbox"]
    },
    "explore": {
      "files": ["packages/desktop/crates/pocket/src/explore.rs"],
      "open": ["select a session", "click the Explore tab"],
      "capture": ["session", "explore"]
    },
    "command-palette-k": {
      "files": ["packages/desktop/crates/pocket/src/overlay.rs"],
      "open": ["press Cmd+K"],
      "capture": ["palette"]
    },
    "new-session": {
      "files": ["packages/desktop/crates/pocket/src/forms.rs"],
      "open": ["press Cmd+N", "type the task prompt"],
      "capture": ["session", "new-session", "prompt"]
    },
    "add-repository": {
      "files": ["packages/desktop/crates/pocket/src/forms.rs"],
      "open": ["click Add project in the sidebar"],
      "capture": ["add-repo"]
    },
    "repositories-worktrees": {
      "files": ["packages/desktop/crates/pocket/src/view.rs"],
      "open": ["select a session", "click its worktree in the sidebar, then the session again"],
      "capture": ["session", "worktree"]
    },
    "compact": {
      "files": ["packages/desktop/crates/pocket/src/view.rs", "packages/desktop/crates/pocket/src/main.rs"],
      "open": ["select a session", "press Cmd+. to collapse to the compact rail"],
      "capture": ["session", "focus"]
    },
    "compact-sidebar-open": {
      "files": ["packages/desktop/crates/pocket/src/view.rs", "packages/desktop/crates/pocket/src/main.rs"],
      "open": ["select a session", "click its worktree in the sidebar, then the session again", "press Cmd+. for the compact rail", "press Cmd+\\ to float the sidebars"],
      "capture": ["session", "worktree", "focus", "rail"]
    },
    "session-terminal-focus": {
      "files": ["packages/desktop/crates/pocket/src/view.rs", "packages/desktop/crates/pocket/src/main.rs"],
      "open": ["select a session", "press Cmd+. twice to hide all sidebars"],
      "capture": ["session", "focus", "focus"]
    },
    "automations": {
      "files": ["packages/desktop/crates/pocket/src/automations.rs", "packages/desktop/crates/pocket/src/automations/**"],
      "open": ["click Automations in the sidebar", "the drawer shows the first automation"],
      "capture": ["automations"]
    },
    "automations-runs": {
      "files": ["packages/desktop/crates/pocket/src/automations/runs.rs"],
      "open": ["click Automations in the sidebar", "click the Runs tab"],
      "capture": ["automations", "automations-runs"]
    },
    "automations-editor": {
      "files": ["packages/desktop/crates/pocket/src/automations/editor.rs"],
      "open": ["click Automations in the sidebar", "click Edit in the drawer"],
      "capture": ["automations", "automations-editor"]
    },
    "settings-general": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,"],
      "capture": ["dark", "settings"]
    },
    "settings-appearance": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Appearance"],
      "capture": ["dark", "settings", "settings-appearance"]
    },
    "settings-notifications": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Notifications & Sounds"],
      "capture": ["dark", "settings", "settings-notifications"]
    },
    "settings-keyboard": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Keyboard"],
      "capture": ["dark", "settings", "settings-keyboard"]
    },
    "settings-keyboard-custom": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**", "packages/desktop/crates/pocket/src/actions.rs"],
      "open": ["press Cmd+,", "click Keyboard", "click a shortcut", "press Cmd+K"],
      "capture": ["dark", "settings", "settings-keyboard", "custom-keys", "key-clash"]
    },
    "settings-projects": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Projects & Worktrees"],
      "capture": ["dark", "settings", "settings-projects"]
    },
    "settings-agents": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Agents"],
      "capture": ["dark", "settings", "settings-agents"]
    },
    "settings-agent-claude": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Agents", "click Claude Code"],
      "capture": ["dark", "settings", "settings-claude"]
    },
    "settings-agent-codex": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Agents", "click Codex"],
      "capture": ["dark", "settings", "settings-codex"]
    },
    "settings-automations": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Automations"],
      "capture": ["dark", "settings", "settings-automations"]
    },
    "settings-automations-stopped": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Automations", "pocketd is not running"],
      "capture": ["dark", "settings", "settings-automations", "service-down"]
    },
    "settings-phone": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Phone & Remote"],
      "capture": ["dark", "settings", "settings-phone"]
    },
    "settings-phone-empty": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Phone & Remote"],
      "capture": ["dark", "settings", "settings-phone", "owner", "no-phones"]
    },
    "settings-project-edit": {
      "files": ["packages/desktop/crates/pocket/src/modals/add_project.rs"],
      "open": ["select a project's session", "open its row menu", "click Project settings"],
      "capture": ["dark", "session", "project-settings"]
    },
    "settings-sidebar": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Sidebar & Inbox"],
      "capture": ["dark", "settings", "settings-sidebar"]
    },
    "settings-terminal": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Terminal"],
      "capture": ["dark", "settings", "settings-terminal"]
    },
    "settings-files": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Files & Editor"],
      "capture": ["dark", "settings", "settings-files"]
    },
    "settings-browser": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Browser"],
      "capture": ["dark", "settings", "settings-browser"]
    },
    "settings-git": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Git & GitHub"],
      "capture": ["dark", "settings", "settings-git"]
    },
    "settings-diff": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "click Diff & Graph"],
      "capture": ["dark", "settings", "settings-diff"]
    },
    "settings-search": {
      "files": ["packages/desktop/crates/pocket/src/settings.rs", "packages/desktop/crates/pocket/src/settings/**"],
      "open": ["press Cmd+,", "type worktree in Search"],
      "capture": ["dark", "settings", "settings-search"]
    }
  }
}
